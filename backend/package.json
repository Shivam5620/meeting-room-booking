{
  "name": "backend",
  "version": "0.8.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --import tsx src/db/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/rules.test.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
